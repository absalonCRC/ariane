{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ariane",
  "version": "0.3.0",
  "identifier": "fr.ariane.writer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ariane",
        "width": 1440,
        "height": 1000,
        "minWidth": 760,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#ffffff"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' source-file: asset: http://asset.localhost data: blob:; frame-src 'self' source-file: blob: asset: http://asset.localhost; worker-src 'self' blob:; connect-src ipc: http://ipc.localhost 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "resources": [
      "resources/engine/llama-server",
      "resources/engine/pandoc",
      "resources/engine/typst",
      "resources/engine/pdf-text",
      "resources/engine/memory.py",
      "resources/engine/memory-model.txt",
      "resources/engine/ai-policy.json",
      "resources/engine/checksums.json",
      "resources/engine/*.dylib",
      "resources/engine/*.so",
      "resources/models/embeddinggemma-300M-Q8_0.gguf",
      "resources/notices/**/*",
      "resources/styles/**/*",
      "resources/voice/transcribe.py"
    ],
    "macOS": {
      "minimumSystemVersion": "26.0",
      "entitlements": "Entitlements.plist",
      "signingIdentity": "-",
      "files": {
        "Resources/fr.lproj/InfoPlist.strings": "locales/fr.lproj/InfoPlist.strings",
        "Resources/en.lproj/InfoPlist.strings": "locales/en.lproj/InfoPlist.strings",
        "Resources/es.lproj/InfoPlist.strings": "locales/es.lproj/InfoPlist.strings"
      }
    },
    "icon": [
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "copyright": "Copyright © 2026 Axel de Saint-Germain",
    "license": "GPL-3.0-only"
  }
}
